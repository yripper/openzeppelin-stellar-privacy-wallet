# @grantfox/api's base URL (Task 11: the CT rail's indexer adapter + activity
# feed both call it directly, cross-origin, over HTTP). Optional — defaults
# to http://localhost:3000 (see app/src/lib/ct.ts's API_URL) if unset. Vite
# only picks up VITE_-prefixed vars, and only from a REAL .env file (copy
# this to app/.env, don't just set it in your shell for `pnpm dev` unless
# you export it into that same shell).
VITE_API_URL=http://localhost:3000
