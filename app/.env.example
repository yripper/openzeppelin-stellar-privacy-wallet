# @grantfox/api's base URL. Optional — defaults to http://localhost:3000 (see
# app/src/lib/api-url.ts) if unset. Vite only picks up VITE_-prefixed vars, and
# only from a REAL .env file (copy this to app/.env, don't just set it in your
# shell for `pnpm dev` unless you export it into that same shell).
#
# Three consumers:
#  - Task 11, CT rail: the indexer adapter (`lib/ct-indexer.ts`) + activity feed.
#  - Task 12, SPP rail: `${VITE_API_URL}/rpc` is the shielded pool's HISTORY
#    SOURCE (`lib/spp.ts`'s SPP_BOOTNODE_URL) — the SDK cannot sync the pool
#    without it, since Nethermind's own bootnode is dead and testnet RPC
#    retention doesn't reach the deployment ledger. The API server must be
#    running AND its DB must hold the SPP backfill
#    (`pnpm --filter @grantfox/api backfill:spp:load`).
VITE_API_URL=http://localhost:3000
