{
  "name": "@grantfox/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor:bb": "node scripts/vendor-bb.mjs",
    "vendor:spp": "node scripts/vendor-spp.mjs",
    "vendor": "pnpm run vendor:bb && pnpm run vendor:spp",
    "predev": "pnpm run vendor",
    "dev": "vite",
    "prebuild": "pnpm run vendor",
    "build": "tsc --noEmit && vite build",
    "prepreview": "pnpm run vendor",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ctd/sdk": "workspace:*",
    "@grantfox/shared": "workspace:*",
    "@stellar/stellar-sdk": "16.2.0",
    "buffer": "^6.0.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "smart-account-kit": "0.4.2",
    "stellar-private-payments": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@aztec/bb.js": "0.87.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
