DATABASE_URL=postgres://grantfox:grantfox@localhost:5433/grantfox
DB_HOST_PORT=5433
CT_AUDITOR_SECRET_HEX=

# Indexer worker (api/src/worker.ts) — all optional, default to TESTNET config
# (packages/shared/src/config.ts). RPC_URL/BOOTNODE_URL must stay UNSET
# (commented out, not `KEY=`) to take their default: an empty string fails
# validation rather than falling back, since zod's `.default()` only applies
# to a missing key. Override RPC_URL for a private/faster RPC; override
# BOOTNODE_URL if Nethermind's public bootnode is down or cache-missing.
POLL_INTERVAL_MS=5000
# RPC_URL=
# BOOTNODE_URL=
